generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SALESMAN
  ADMIN
  PRODUCTION
  ACCOUNTANT
  OWNER
}

enum ItemType {
  RAW
  PACKAGING
  FINISHED
}

enum UnitDimension {
  MASS
  VOLUME
  COUNT
}

enum CustomerType {
  RETAILER
  DISTRIBUTOR
}

enum MovementType {
  OPENING
  PURCHASE
  PRODUCTION_ISSUE
  PRODUCTION_OUTPUT
  PRODUCTION_SCRAP
  DISPATCH
  SALES_RETURN
  ADJUSTMENT
}

enum SourceType {
  OPENING
  PURCHASE
  PRODUCTION_RUN
  INVOICE
  DISPATCH
  CREDIT_NOTE
  ADJUSTMENT
}

enum RunStatus {
  ISSUED
  COMPLETED
  CANCELLED
}

enum OverheadKind {
  LABOUR
  POWER_GAS
  OTHER
}

enum OrderStatus {
  SUBMITTED
  APPROVED
  REJECTED
  INVOICED
  DISPATCHED
  CANCELLED
}

enum InvoiceStatus {
  POSTED
  CANCELLED
}

enum PaymentMode {
  CASH
  UPI
  BANK
  CHEQUE
}

model User {
  id                 Int               @id @default(autoincrement())
  name               String
  email              String            @unique
  /// Store only a one-way password hash, never a plain-text password.
  passwordHash       String
  /// Role used to authorize access to application functions.
  role               Role
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  assignedCustomers  Customer[]        @relation("AssignedSalesman")
  purchases          Purchase[]
  startedRuns        ProductionRun[]   @relation("RunStartedBy")
  completedRuns      ProductionRun[]   @relation("RunCompletedBy")
  stockMovements     StockMovement[]
  auditLogs          AuditLog[]
  salesOrders        Order[]           @relation("OrderSalesman")
  approvedOrders     Order[]           @relation("OrderApprovedBy")
  createdInvoices    Invoice[]
  createdDispatches  Dispatch[]
  createdPayments    Payment[]
  createdCreditNotes CreditNote[]
  stockAdjustments   StockAdjustment[]
}

model Unit {
  id                 Int           @id @default(autoincrement())
  code               String        @unique
  name               String
  /// Physical dimension used to keep unit conversions compatible.
  dimension          UnitDimension
  /// Number of base units represented by one unit of this code.
  baseFactor         Int
  itemsAsBaseUnit    Item[]        @relation("ItemBaseUnit")
  itemsAsDisplayUnit Item[]        @relation("ItemDisplayUnit")
}

model Item {
  id                Int                 @id @default(autoincrement())
  code              String              @unique
  name              String
  type              ItemType
  /// Unit in which stock quantities are stored as integers.
  baseUnitId        Int
  baseUnit          Unit                @relation("ItemBaseUnit", fields: [baseUnitId], references: [id])
  /// Unit used to display quantities to people.
  displayUnitId     Int
  displayUnit       Unit                @relation("ItemDisplayUnit", fields: [displayUnitId], references: [id])
  /// Harmonized System classification used on GST documents.
  hsnCode           String?
  /// GST rate in basis points (for example, 5% is 500).
  gstRateBp         Int                 @default(0)
  /// Number of packets in a carton, for finished goods sold by packet.
  packsPerCarton    Int?
  /// Default list price in integer paise.
  sellingPricePaise Int?
  /// Reorder threshold in integer base units.
  reorderLevelBase  Int?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  customerPrices    CustomerPrice[]
  finishedBoms      Bom[]               @relation("BomFinishedItem")
  bomLines          BomLine[]           @relation("BomLineItem")
  purchaseLines     PurchaseLine[]
  finishedRuns      ProductionRun[]     @relation("RunFinishedItem")
  productionLines   ProductionRunLine[]
  stockMovements    StockMovement[]
  stockAdjustments  StockAdjustment[]
  orderLines        OrderLine[]
  invoiceLines      InvoiceLine[]
  dispatchLines     DispatchLine[]

  @@index([baseUnitId])
  @@index([displayUnitId])
}

model Customer {
  id                 Int             @id @default(autoincrement())
  name               String
  type               CustomerType
  /// GST registration number, when registered.
  gstin              String?
  /// GST state code, such as 33 for Tamil Nadu or 29 for Karnataka.
  stateCode          String
  stateName          String
  address            String?
  phone              String?
  /// Optional user responsible for this customer's sales.
  assignedSalesmanId Int?
  assignedSalesman   User?           @relation("AssignedSalesman", fields: [assignedSalesmanId], references: [id])
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  prices             CustomerPrice[]
  orders             Order[]
  invoices           Invoice[]
  payments           Payment[]

  @@index([assignedSalesmanId])
}

model Supplier {
  id        Int        @id @default(autoincrement())
  name      String
  /// GST registration number, when registered.
  gstin     String?
  /// GST state code, when the supplier's state is known.
  stateCode String?
  phone     String?
  address   String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  purchases Purchase[]
}

model CustomerPrice {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])
  itemId     Int
  item       Item     @relation(fields: [itemId], references: [id])
  /// Customer-specific selling price in integer paise.
  pricePaise Int

  @@unique([customerId, itemId])
  @@index([customerId])
  @@index([itemId])
}

model Setting {
  /// Stable setting key, such as COMPANY_NAME or FY_START_MONTH.
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Bom {
  id             Int             @id @default(autoincrement())
  name           String
  finishedItemId Int
  finishedItem   Item            @relation("BomFinishedItem", fields: [finishedItemId], references: [id])
  version        Int             @default(1)
  isActive       Boolean         @default(true)
  batchYieldQty  Int
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  lines          BomLine[]
  productionRuns ProductionRun[]

  @@unique([finishedItemId, version])
}

model BomLine {
  id          Int  @id @default(autoincrement())
  bomId       Int
  bom         Bom  @relation(fields: [bomId], references: [id], onDelete: Cascade)
  itemId      Int
  item        Item @relation("BomLineItem", fields: [itemId], references: [id])
  qtyPerBatch Int

  @@unique([bomId, itemId])
}

model Purchase {
  id                Int            @id @default(autoincrement())
  number            String         @unique
  supplierId        Int
  supplier          Supplier       @relation(fields: [supplierId], references: [id])
  purchaseDate      DateTime
  supplierInvoiceNo String?
  totalPaise        Int
  notes             String?
  createdById       Int
  createdBy         User           @relation(fields: [createdById], references: [id])
  createdAt         DateTime       @default(now())
  lines             PurchaseLine[]
}

model PurchaseLine {
  id               Int       @id @default(autoincrement())
  purchaseId       Int
  purchase         Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  itemId           Int
  item             Item      @relation(fields: [itemId], references: [id])
  qty              Int
  ratePaisePerBase Decimal   @db.Decimal(18, 6)
  amountPaise      Int
  batchNo          String?
  expiryDate       DateTime?
}

model ProductionRun {
  id                  Int                  @id @default(autoincrement())
  runNo               String               @unique
  bomId               Int
  bom                 Bom                  @relation(fields: [bomId], references: [id])
  finishedItemId      Int
  finishedItem        Item                 @relation("RunFinishedItem", fields: [finishedItemId], references: [id])
  status              RunStatus
  batchCount          Decimal              @default(1) @db.Decimal(10, 4)
  plannedOutputQty    Int
  actualGoodQty       Int?
  rejectedFinishedQty Int                  @default(0)
  yieldVarianceBp     Int?
  yieldFlagged        Boolean              @default(false)
  toleranceBpUsed     Int
  materialCostPaise   Int?
  overheadCostPaise   Int?
  costPerPacketPaise  Decimal?             @db.Decimal(14, 4)
  batchNo             String?
  startedAt           DateTime
  completedAt         DateTime?
  startedById         Int
  startedBy           User                 @relation("RunStartedBy", fields: [startedById], references: [id])
  completedById       Int?
  completedBy         User?                @relation("RunCompletedBy", fields: [completedById], references: [id])
  notes               String?
  lines               ProductionRunLine[]
  overheads           ProductionOverhead[]
}

model ProductionRunLine {
  id               Int           @id @default(autoincrement())
  runId            Int
  run              ProductionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  itemId           Int
  item             Item          @relation(fields: [itemId], references: [id])
  plannedQty       Int
  issuedQty        Int
  scrapQty         Int           @default(0)
  varianceBp       Int?
  flagged          Boolean       @default(false)
  ratePaisePerBase Decimal       @db.Decimal(18, 6)
  costPaise        Int

  @@unique([runId, itemId])
}

model ProductionOverhead {
  id          Int           @id @default(autoincrement())
  runId       Int
  run         ProductionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind        OverheadKind
  amountPaise Int
  note        String?
}

model StockMovement {
  id               Int          @id @default(autoincrement())
  itemId           Int
  item             Item         @relation(fields: [itemId], references: [id])
  movementType     MovementType
  qtyChange        Int
  ratePaisePerBase Decimal?     @db.Decimal(18, 6)
  valuePaise       Int?
  sourceType       SourceType
  sourceId         Int?
  sourceRef        String?
  batchNo          String?
  expiryDate       DateTime?
  movementDate     DateTime
  note             String?
  createdById      Int?
  createdBy        User?        @relation(fields: [createdById], references: [id])
  createdAt        DateTime     @default(now())

  @@index([itemId, movementDate])
  @@index([sourceType, sourceId])
}

model StockAdjustment {
  id          Int      @id @default(autoincrement())
  number      String   @unique
  itemId      Int
  item        Item     @relation(fields: [itemId], references: [id])
  qtyChange   Int
  reason      String
  note        String?
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([itemId, createdAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  Int?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model Order {
  id           Int         @id @default(autoincrement())
  orderNo      String      @unique
  clientRef    String?     @unique
  customerId   Int
  customer     Customer    @relation(fields: [customerId], references: [id])
  salesmanId   Int
  salesman     User        @relation("OrderSalesman", fields: [salesmanId], references: [id])
  status       OrderStatus @default(SUBMITTED)
  notes        String?
  rejectReason String?
  createdAt    DateTime    @default(now())
  approvedById Int?
  approvedBy   User?       @relation("OrderApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  updatedAt    DateTime    @updatedAt
  lines        OrderLine[]
  invoice      Invoice?
}

model OrderLine {
  id                 Int   @id @default(autoincrement())
  orderId            Int
  order              Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId             Int
  item               Item  @relation(fields: [itemId], references: [id])
  qty                Int
  pricePaise         Int
  approvedQty        Int?
  approvedPricePaise Int?
}

model Invoice {
  id                     Int           @id @default(autoincrement())
  invoiceNo              String        @unique
  financialYear          String
  orderId                Int?          @unique
  order                  Order?        @relation(fields: [orderId], references: [id])
  customerId             Int
  customer               Customer      @relation(fields: [customerId], references: [id])
  issueDate              DateTime
  placeOfSupplyStateCode String
  isInterState           Boolean
  taxableValuePaise      Int
  cgstPaise              Int           @default(0)
  sgstPaise              Int           @default(0)
  igstPaise              Int           @default(0)
  totalPaise             Int
  status                 InvoiceStatus @default(POSTED)
  cancelledAt            DateTime?
  cancelReason           String?
  createdById            Int
  createdBy              User          @relation(fields: [createdById], references: [id])
  createdAt              DateTime      @default(now())
  lines                  InvoiceLine[]
  dispatches             Dispatch[]
  payments               Payment[]
  creditNotes            CreditNote[]
}

model InvoiceLine {
  id                Int     @id @default(autoincrement())
  invoiceId         Int
  invoice           Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId            Int
  item              Item    @relation(fields: [itemId], references: [id])
  description       String
  hsnCode           String?
  qty               Int
  ratePaise         Int
  taxableValuePaise Int
  gstRateBp         Int
  cgstPaise         Int
  sgstPaise         Int
  igstPaise         Int
  totalPaise        Int
}

model Dispatch {
  id           Int            @id @default(autoincrement())
  dispatchNo   String         @unique
  invoiceId    Int
  invoice      Invoice        @relation(fields: [invoiceId], references: [id])
  dispatchDate DateTime
  vehicleNo    String?
  notes        String?
  createdById  Int
  createdBy    User           @relation(fields: [createdById], references: [id])
  lines        DispatchLine[]
}

model DispatchLine {
  id         Int      @id @default(autoincrement())
  dispatchId Int
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  itemId     Int
  item       Item     @relation(fields: [itemId], references: [id])
  qty        Int
}

model Payment {
  id          Int         @id @default(autoincrement())
  receiptNo   String      @unique
  customerId  Int
  customer    Customer    @relation(fields: [customerId], references: [id])
  invoiceId   Int?
  invoice     Invoice?    @relation(fields: [invoiceId], references: [id])
  amountPaise Int
  mode        PaymentMode
  reference   String?
  paymentDate DateTime
  notes       String?
  createdById Int
  createdBy   User        @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
}

model CreditNote {
  id                Int      @id @default(autoincrement())
  noteNo            String   @unique
  invoiceId         Int
  invoice           Invoice  @relation(fields: [invoiceId], references: [id])
  reason            String
  taxableValuePaise Int
  cgstPaise         Int
  sgstPaise         Int
  igstPaise         Int
  totalPaise        Int
  createdById       Int
  createdBy         User     @relation(fields: [createdById], references: [id])
  createdAt         DateTime @default(now())
}

model DocumentCounter {
  key        String @id
  lastNumber Int    @default(0)
}
